DATABASE_URL=postgresql://user:pass@host:26257/oncall?sslmode=verify-full

COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=
COCKROACH_MCP_CLUSTER_ID=

# Allowed CORS origins, comma separated.
CORS_ORIGINS=http://localhost:5173

LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock

AWS_REGION=us-east-1
# Optional: Bedrock API key (ABSK... prefix), as an alternative to SigV4
# credentials. It is propagated to AWS_BEARER_TOKEN_BEDROCK, which is where boto3
# reads it from. If that variable already comes from the environment, the
# environment wins.
BEDROCK_API_KEY=
# Claude Sonnet 4.5 does not allow on-demand invocation with the bare ID: it needs
# an inference profile prefix, and it has to match AWS_REGION.
#   us-* / ca-*  -> us.        eu-*  -> eu.        ap-southeast-2/4/6 -> au.
#   ap-northeast-1/3 -> jp.    from any commercial region -> global.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Embedding models do not use inference profiles: the bare ID goes here.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

ANTHROPIC_API_KEY=

# Free alternative to Bedrock: Google Gemini (free tier, one key does LLM and
# embeddings). To use it: LLM_PROVIDER=gemini and/or EMBEDDING_PROVIDER=gemini.
# The embedding comes out at 1024 dims (output_dimensionality), so there is no
# need to migrate the VECTOR(1024) table.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# MOCK_SEED=42
