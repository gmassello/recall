DATABASE_URL=postgresql://user:pass@host:26257/oncall?sslmode=verify-full

COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=
COCKROACH_MCP_CLUSTER_ID=

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock

AWS_REGION=us-east-1
# Opcional: API key de Bedrock (prefijo ABSK...), como alternativa a las credenciales
# SigV4. Se propaga a AWS_BEARER_TOKEN_BEDROCK, que es de donde la lee boto3. Si esa
# variable ya viene del entorno, gana la del entorno.
BEDROCK_API_KEY=
# Claude Sonnet 4.5 no admite invocacion on-demand con el ID desnudo: hace falta
# prefijo de inference profile, y tiene que acompanar a AWS_REGION.
#   us-* / ca-*  -> us.        eu-*  -> eu.        ap-southeast-2/4/6 -> au.
#   ap-northeast-1/3 -> jp.    desde cualquier region comercial -> global.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Los modelos de embedding no usan inference profiles: va el ID desnudo.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

ANTHROPIC_API_KEY=

# Alternativa gratis a Bedrock: Google Gemini (free tier, una key hace LLM y embeddings).
# Para usarla: LLM_PROVIDER=gemini y/o EMBEDDING_PROVIDER=gemini. El embedding sale a
# 1024 dims (output_dimensionality), asi que no hay que migrar la tabla VECTOR(1024).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# MOCK_SEED=42
